rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'mahendra04165@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'role']) &&
             data.userId is string &&
             data.email is string &&
             data.role in ['user', 'admin'] &&
             (data.get('displayName', '') is string) &&
             (data.get('photoURL', '') is string);
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['title', 'category', 'date', 'location', 'totalCapacity', 'availableTickets', 'status']) &&
             data.title is string && data.title.size() <= 200 &&
             data.category in ['Tech', 'Cultural', 'Sports'] &&
             data.date is timestamp &&
             data.location is string &&
             data.totalCapacity is number &&
             data.availableTickets is number &&
             data.status in ['upcoming', 'cancelled', 'completed'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['userId', 'eventId', 'tickets', 'totalAmount', 'status']) &&
             data.userId is string &&
             data.eventId is string &&
             data.tickets is list &&
             data.totalAmount is number &&
             data.status in ['pending', 'confirmed', 'cancelled'];
    }

    // --- Rules ---

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isSignedIn() && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'wishlist', 'updatedAt'])) ||
        isAdmin()
      );
    }

    // Events collection
    match /events/{eventId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() && isValidEvent(incoming());
      allow update: if isAdmin() && isValidEvent(incoming());
      allow delete: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isOwner(incoming().userId) && isValidBooking(incoming());
      allow update: if isSignedIn() && (
        (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        isAdmin()
      );
    }
  }
}
